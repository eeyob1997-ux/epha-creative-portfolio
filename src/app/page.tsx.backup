            </p>
            <h2 className="text-3xl font-bold leading-tight">
              I&apos;m a{" "}
              <span className="text-[#c9ff27]">Graphic Designer</span>
            </h2>
            <p className="mt-4 text-sm leading-7 text-neutral-400">
              I&apos;m passionate about turning simple ideas into powerful
              visuals. With a focus on clean design, modern aesthetics and brand
              storytelling, I help businesses and individuals bring their ideas
              to life.
            </p>
            <a
              href="#contact"
              className="mt-5 inline-flex items-center gap-2 rounded-full bg-[#c9ff27] px-5 py-3 text-xs font-bold text-black transition hover:bg-white"
            >
              Let&apos;s Work Together <ArrowRight size={14} />
            </a>
          </motion.div>

          <motion.div
            variants={sectionReveal}
            className="border-t border-white/10 pt-7 md:border-l md:border-t-0 md:pl-7 md:pt-0"
          >
            <div className="grid grid-cols-3 gap-3 text-center">
              {[
                ["3+", "Years Experience"],
                ["50+", "Projects Completed"],
                ["30+", "Happy Clients"],
              ].map(([number, label]) => (
                <div key={label}>
                  <p className="text-xl font-bold text-[#c9ff27] sm:text-2xl">
