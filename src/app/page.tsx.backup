const navigation = [
  ["Home", "#home"],
  ["Portfolio", "#portfolio"],
  ["About", "#about"],
  ["Services", "#services"],
  ["Testimonials", "#testimonials"],
  ["Contact", "#contact"],
];

const sectionReveal = {
  hidden: { opacity: 0, y: 35 },
  visible: {
    opacity: 1,
    y: 0,
    transition: { duration: 0.65, ease: "easeOut" as const },
  },
};

const cardReveal = {
  hidden: { opacity: 0, y: 25 },
  visible: {
    opacity: 1,
    y: 0,
    transition: { duration: 0.5, ease: "easeOut" as const },
  },
};

const staggerContainer = {
  hidden: {},
  visible: {
    transition: { staggerChildren: 0.12 },
  },
};

export default function Home() {
  const [activeFilter, setActiveFilter] = useState("All");
  const [showAllProjects, setShowAllProjects] = useState(false);
  const [showAllFeedback, setShowAllFeedback] = useState(false);
  const [menuOpen, setMenuOpen] = useState(false);

  const [form, setForm] = useState({
    name: "",
    email: "",
    message: "",
  });

  const [sending, setSending] = useState(false);
  const [notice, setNotice] = useState("");

  const visibleProjects =
    activeFilter === "All"
      ? projects
      : projects.filter((project) => project.category === activeFilter);

  const displayedProjects = showAllProjects
    ? visibleProjects
    : visibleProjects.slice(0, 3);

  const displayedTestimonials = showAllFeedback
    ? testimonials
    : testimonials.slice(0, 3);

  async function sendMessage(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setSending(true);
    setNotice("");

    try {
      const response = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(form),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || "Unable to send your message.");
      }

      setNotice("Message sent successfully. Thank you!");
      setForm({ name: "", email: "", message: "" });
    } catch (error) {
      setNotice(
        error instanceof Error
          ? error.message
          : "Something went wrong. Please try again.",
      );
    } finally {
      setSending(false);
    }
  }

  return (
    <main className="min-h-screen overflow-hidden bg-[#0b0c0c] text-white">
      {/* Navigation */}
      <header className="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-[#0b0c0c]/90 shadow-lg shadow-black/5 backdrop-blur-xl transition-all duration-300">
        <div className="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-2.5 sm:px-6 md:px-8">
          <a
            href="#home"
            aria-label="EPHA Creative home"
            onClick={() => setMenuOpen(false)}
            className="flex min-w-0 items-center gap-2"
          >
            <img
              src="/logo.png"
              alt="EPHA Creative logo"
              className="h-8 w-8 shrink-0 object-contain sm:h-9 sm:w-9"
            />
            <span className="whitespace-nowrap font-brand text-xs font-bold tracking-[0.08em] text-white sm:text-lg sm:tracking-[0.12em]">
              EPHA <span className="text-[#c9ff27]">CREATIVE</span>
            </span>
          </a>

          <nav className="hidden items-center gap-6 text-sm text-neutral-200 lg:flex">
            {navigation.map(([label, href]) => (
              <a
                key={label}
                href={href}
                className="transition-colors duration-200 hover:text-[#c9ff27]"
              >
                {label}
              </a>
            ))}
          </nav>

          <div className="flex shrink-0 items-center gap-2">
            <a
              href="#contact"
              className="rounded-full bg-[#c9ff27] px-3 py-2.5 text-[10px] font-bold text-black transition hover:bg-white sm:px-5 sm:py-3 sm:text-xs"
            >
              Let&apos;s Talk <ArrowRight className="ml-1 inline" size={13} />
            </a>

            <button
              type="button"
              aria-label={
                menuOpen ? "Close navigation menu" : "Open navigation menu"
              }
              aria-expanded={menuOpen}
              onClick={() => setMenuOpen((previous) => !previous)}
              className="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 text-white transition hover:border-[#c9ff27] hover:text-[#c9ff27] lg:hidden"
            >
              {menuOpen ? <X size={20} /> : <Menu size={20} />}
            </button>
          </div>
        </div>

        {menuOpen && (
          <nav className="border-t border-white/10 bg-[#0b0c0c] px-5 py-4 lg:hidden">
            <div className="mx-auto flex max-w-6xl flex-col gap-1">
              {navigation.map(([label, href]) => (
                <a
                  key={label}
                  href={href}
                  onClick={() => setMenuOpen(false)}
                  className="rounded-lg px-3 py-3 text-sm text-neutral-200 transition hover:bg-white/5 hover:text-[#c9ff27]"
                >
                  {label}
                </a>
              ))}
            </div>
          </nav>
        )}
      </header>

      {/* Hero — preserved as provided; no new animations */}
      <section
        id="home"
        className="mx-auto grid max-w-6xl scroll-mt-24 items-center gap-5 px-4 pb-16 pt-28 sm:px-6 md:min-h-[550px] md:grid-cols-2 md:px-8 md:pb-20 md:pt-28"
      >
        <div className="relative z-10">
          <p className="mb-5 text-[10px] font-semibold uppercase tracking-[0.3em] text-neutral-400">
            Graphic Designer
          </p>

          <h1 className="text-4xl font-bold leading-[1.05] tracking-[-0.055em] sm:text-6xl lg:text-7xl">
            Turning Ideas
            <br />
            into <span className="text-[#c9ff27]">Visuals</span>
          </h1>

          <p className="mt-6 max-w-md text-sm leading-6 text-neutral-400">
            I&apos;m a graphic designer who loves creating clean, bold and
            meaningful designs. I help brands tell their story through visuals
            that inspire and connect.
          </p>

          <div className="mt-7 flex flex-wrap items-center gap-4 sm:gap-7">
            <a
              href="#portfolio"
              className="rounded-full bg-[#c9ff27] px-5 py-3 text-xs font-bold text-black transition hover:bg-white"
            >
              View My Work <ArrowRight className="ml-2 inline" size={14} />
            </a>
            <a
              href="#about"
              className="border-b border-[#c9ff27] pb-1 text-xs text-neutral-200"
            >
              About Me
            </a>
          </div>
        </div>

        <div className="relative mx-auto flex min-h-[320px] w-full max-w-lg items-center justify-center sm:min-h-[380px] md:min-h-[410px]">
          <div className="absolute right-2 top-12 z-10 hidden w-32 rotate-[8deg] bg-white p-3 text-black shadow-xl sm:block">
            <p className="text-xl font-black leading-none">
              IDEAS
              <br />
              BRAND
              <br />
              IMPACT
            </p>
            <div className="mt-3 h-24 bg-gradient-to-br from-pink-500 via-orange-400 to-blue-600" />
          </div>

          <div className="absolute bottom-8 left-1 z-20 -rotate-12 font-serif text-xl italic leading-tight text-[#c9ff27] sm:bottom-10 sm:text-2xl">
            Good
            <br />
            Design
            <br />
            Matters
          </div>

          <div className="absolute right-1 top-1/2 z-20 flex -translate-y-1/2 flex-col gap-3">
            {["#c9ff27", "#a855f7", "#a1a1aa", "#18181b"].map((color) => (
              <span
                key={color}
                className="h-5 w-5 rounded-full border border-white/20 sm:h-6 sm:w-6"
                style={{ backgroundColor: color }}
              />
            ))}
          </div>

          <div className="relative mx-auto flex min-h-[340px] w-full max-w-lg items-center justify-center sm:min-h-[410px]">
            <div className="absolute left-1/2 top-[42%] h-[230px] w-[230px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#c9ff27] blur-md sm:h-[280px] sm:w-[280px] md:h-[320px] md:w-[320px]" />
            <img
              src="/image%20(2).png"
              alt="Portrait for epha creative"
              className="relative z-10 mt-8 h-[300px] w-[80%] object-cover object-top grayscale sm:h-[350px] md:h-[400px]"
            />
          </div>

          <span className="absolute left-[8%] top-8 z-20 text-4xl text-[#c9ff27]">
            ✦
          </span>
        </div>
      </section>

      {/* Portfolio */}
      <section
        id="portfolio"
        className="relative scroll-mt-20 overflow-hidden bg-[#080909] px-4 py-12 text-white sm:px-8 md:py-16"
      >
        <div className="pointer-events-none absolute -left-40 top-20 h-80 w-80 rounded-full bg-[#c9ff27]/[0.06] blur-[100px]" />
        <div className="pointer-events-none absolute -right-40 bottom-10 h-80 w-80 rounded-full bg-[#c9ff27]/[0.05] blur-[100px]" />

        <div className="relative z-10 mx-auto max-w-6xl">
          <motion.div
            variants={staggerContainer}
            initial="hidden"
            whileInView="visible"
            viewport={{ once: true, amount: 0.2 }}
            className="mb-8 flex flex-col justify-between gap-6 xl:flex-row xl:items-start"
          >
            <motion.div variants={sectionReveal} className="max-w-xl">
              <div className="mb-3 flex items-center gap-4">
                <span className="text-[11px] font-medium uppercase tracking-[0.35em] text-white/70">
                  My Work
                </span>
                <span className="h-[2px] w-14 bg-[#c9ff27]" />
              </div>
              <h2 className="text-3xl font-bold tracking-[-0.04em] sm:text-5xl">
                Recent <span className="text-[#c9ff27]">Work</span>
              </h2>
              <p className="mt-4 max-w-md text-sm leading-6 text-neutral-400">
                A collection of my latest design projects, where creativity
                meets purpose. Each piece tells a story.
              </p>
            </motion.div>

            <motion.div
              variants={sectionReveal}
              className="flex flex-wrap gap-2 xl:max-w-[590px] xl:justify-end xl:pt-5"
            >
              {filters.map((filter) => (
                <button
                  key={filter}
                  type="button"
                  aria-pressed={activeFilter === filter}
                  onClick={() => {
                    setActiveFilter(filter);
                    setShowAllProjects(false);
                  }}
                  className={`rounded-full border px-3 py-2 text-[11px] transition-all duration-300 sm:px-4 sm:py-2.5 sm:text-xs ${activeFilter === filter ? "border-[#c9ff27] bg-[#c9ff27] font-semibold text-black shadow-[0_0_22px_rgba(201,255,39,0.18)]" : "border-white/15 bg-white/[0.02] text-neutral-300 hover:border-[#c9ff27]/70 hover:text-[#c9ff27]"}`}
                >
                  {filter === "Social Media Design"
                    ? "Social Media"
                    : filter === "Poster Design"
                      ? "Posters"
                      : filter === "Digital Design"
                        ? "Digital"
                        : filter}
                </button>
              ))}
            </motion.div>
          </motion.div>

          <motion.div
            layout
            className="grid grid-cols-2 items-start gap-2.5 sm:gap-4 lg:grid-cols-3 lg:gap-5"
          >
            <AnimatePresence mode="popLayout">
              {displayedProjects.map((project) => (
                <motion.article
                  layout
                  key={project.title}
                  variants={cardReveal}
                  initial="hidden"
                  animate="visible"
                  exit={{ opacity: 0, scale: 0.94 }}
                  transition={{ duration: 0.35 }}
                  whileHover={{ y: -5 }}
                  className="group min-w-0 self-start overflow-hidden rounded-xl border border-white/10 bg-gradient-to-b from-[#121414] to-[#0c0d0d] hover:border-[#c9ff27]/50"
                >
                  <div className="w-full overflow-hidden bg-[#111212]">
                    <img
                      src={project.image}
                      alt={project.title}
                      loading="lazy"
                      className="block h-auto w-full object-contain transition-transform duration-500 group-hover:scale-[1.02]"
                    />
                  </div>
                  <div className="p-2.5 sm:p-4">
                    <p className="mb-1.5 text-[9px] font-medium text-[#c9ff27] sm:text-xs">
                      {project.category}
                    </p>
                    <div className="flex items-start justify-between gap-1.5">
                      <div className="min-w-0">
                        <h3 className="text-[11px] font-semibold leading-4 text-white sm:text-sm sm:leading-5">
                          {project.title}
                        </h3>
                        <p className="mt-2 text-[9px] text-neutral-500 sm:text-xs">
                          {"client" in project
                            ? project.client
                            : "Personal Project"}
                        </p>
                      </div>
                      <span
                        aria-hidden="true"
                        className="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-[#c9ff27]/70 text-sm text-[#c9ff27] transition group-hover:bg-[#c9ff27] group-hover:text-black sm:h-8 sm:w-8"
                      >
                        ↗
                      </span>
                    </div>
                  </div>
                </motion.article>
              ))}
            </AnimatePresence>
          </motion.div>

          {visibleProjects.length > 3 && (
            <motion.div
              variants={sectionReveal}
              initial="hidden"
              whileInView="visible"
              viewport={{ once: true }}
              className="mt-9 flex items-center justify-center gap-5"
            >
              <span className="hidden h-px w-10 bg-[#c9ff27]/50 sm:block" />
              <button
                type="button"
                onClick={() => setShowAllProjects((previous) => !previous)}
                className="inline-flex items-center gap-3 rounded-full border border-[#c9ff27] px-7 py-3 text-sm font-semibold text-white transition-all duration-300 hover:bg-[#c9ff27] hover:text-black"
              >
                {showAllProjects ? "Show Less" : "Show More"}{" "}
                <span className="text-lg">{showAllProjects ? "↑" : "↓"}</span>
              </button>
              <span className="hidden h-px w-10 bg-[#c9ff27]/50 sm:block" />
            </motion.div>
          )}

          <motion.div
            variants={sectionReveal}
            initial="hidden"
            whileInView="visible"
            viewport={{ once: true }}
            className="mt-8 flex flex-col justify-between gap-3 rounded-xl border border-[#c9ff27]/20 bg-white/[0.02] p-3 sm:flex-row sm:items-center sm:px-6"
          >
            <div className="flex items-center gap-3">
              <span className="text-base text-[#c9ff27]">Epha</span>
              <span className="h-8 w-px bg-[#c9ff27]/50" />
              <p className="max-w-md text-xs leading-5 text-neutral-300 sm:text-sm">
                Every project is crafted with creativity, care, and purpose.
              </p>
            </div>
            <a
              href="#contact"
              className="inline-flex w-full shrink-0 items-center justify-center gap-2 rounded-full bg-[#c9ff27] px-4 py-3 text-xs font-bold text-black transition hover:bg-white sm:w-auto sm:text-sm"
            >
              Let&apos;s Work Together <ArrowRight size={15} />
            </a>
          </motion.div>
        </div>
      </section>

      {/* About */}
      <section
        id="about"
        className="mx-auto max-w-6xl scroll-mt-20 px-4 py-16 sm:px-6 md:px-8 md:py-20"
      >
        <motion.div
          variants={staggerContainer}
          initial="hidden"
          whileInView="visible"
          viewport={{ once: true, amount: 0.2 }}
          className="grid gap-10 md:grid-cols-[200px_1fr_1fr] md:items-center"
        >
          <motion.div
            variants={sectionReveal}
            className="relative mx-auto w-full max-w-[240px] md:max-w-none"
          >
            <div className="absolute -inset-3 rounded-[32px] bg-[#c9ff27]/10 blur-xl" />
            <div className="relative overflow-hidden rounded-[28px] border border-[#c9ff27]/70 bg-[#111212] shadow-[0_0_25px_rgba(201,255,39,0.08)]">
              <img
                src="/image.png"
                alt="Ephrem Eyob — Graphic Designer"
                loading="lazy"
                className="block aspect-[3/4] w-full object-cover object-top grayscale transition duration-500 hover:scale-105 hover:grayscale-0"
              />
            </div>
            <div className="absolute -right-2 -top-2 h-7 w-7 rounded-full border-2 border-[#c9ff27] bg-[#0b0c0c]" />
