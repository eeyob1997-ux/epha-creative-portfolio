  Mail,
  MapPin,
  Phone,
  Pencil,
  Image as ImageIcon,
  LayoutGrid,
  Monitor,
  Instagram,
  Dribbble,
  Linkedin,
  Send,
  Menu,
  X,
} from "lucide-react";

const projects = [
  {
    title: "YouTube Thumbnail",
    category: "YouTube Design",
    image: "/tumb 2@3x.jpg",
  },
  {
